// Test Bin1LNormMode: flat VL-aligned, repeat ≤ 255, stride = CCE constant 8.
// 4x32 f32 — cols=32, epr=32, nonVLAligned=false, headRepeats=4, tail=0.

// RUN: ( mkdir -p %T && ptoas --pto-arch=a3 --pto-backend=vpto %s -o %t --mlir-print-ir-after=pto-lower-to-ubuf-ops 2>&1 || true ) | FileCheck %s

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @lower_tadd_flat() attributes {pto.aicore} {
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=32, v_row=4, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=32, v_row=4, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=32, v_row=4, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tadd ins(%src0, %src1 : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=32, v_row=4, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=32, v_row=4, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=32, v_row=4, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// Bin1LNormMode: vadd(repeat=4, repStride=8), no mask, no tail
// CHECK-LABEL: func.func @lower_tadd_flat
// CHECK: %c4_i64 = arith.constant 4 : i64
// CHECK: %c8_i64 = arith.constant 8 : i64
// CHECK: pto.ub.vadd {{%.*}}, {{%.*}}, {{%.*}}, %c4_i64, {{%.*}}, {{%.*}}, {{%.*}}, %c8_i64, %c8_i64, %c8_i64
// CHECK-NOT: pto.ub.set_mask
// CHECK-NOT: pto.tadd
