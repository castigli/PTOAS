// RUN: ( mkdir -p %T && ptoas --pto-arch=a3 --pto-backend=vpto %s -o %t --mlir-print-ir-after=convert-func-to-llvm 2>&1 || true ) | FileCheck %s

// CHECK-LABEL: llvm.func @ub_vadd_s16_mix_aiv
// CHECK: llvm.call @llvm.hivm.VADD.s16
module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @ub_vadd_s16(%dst: !pto.ptr<i16, ub>, %src0: !pto.ptr<i16, ub>, %src1: !pto.ptr<i16, ub>) attributes {pto.aicore} {
    %c128 = arith.constant 128 : i64
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c2 = arith.constant 2 : i64
    %c3 = arith.constant 3 : i64
    %c4 = arith.constant 4 : i64
    %c5 = arith.constant 5 : i64
    pto.ub.vadd %dst, %src0, %src1, %c128, %c0, %c1, %c2, %c3, %c4, %c5 : !pto.ptr<i16, ub>, !pto.ptr<i16, ub>, !pto.ptr<i16, ub>, i64, i64, i64, i64, i64, i64, i64
    return
  }

// CHECK-LABEL: llvm.func @ub_vadd_f16_mix_aiv
// CHECK: llvm.call @llvm.hivm.VADD.f16
  func.func @ub_vadd_f16(%dst: !pto.ptr<f16, ub>, %src0: !pto.ptr<f16, ub>, %src1: !pto.ptr<f16, ub>) attributes {pto.aicore} {
    %c128 = arith.constant 128 : i64
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c2 = arith.constant 2 : i64
    %c3 = arith.constant 3 : i64
    %c4 = arith.constant 4 : i64
    %c5 = arith.constant 5 : i64
    pto.ub.vadd %dst, %src0, %src1, %c128, %c0, %c1, %c2, %c3, %c4, %c5 : !pto.ptr<f16, ub>, !pto.ptr<f16, ub>, !pto.ptr<f16, ub>, i64, i64, i64, i64, i64, i64, i64
    return
  }

// CHECK-LABEL: llvm.func @ub_vadd_s32_mix_aiv
// CHECK: llvm.call @llvm.hivm.VADD.s32
  func.func @ub_vadd_s32(%dst: !pto.ptr<i32, ub>, %src0: !pto.ptr<i32, ub>, %src1: !pto.ptr<i32, ub>) attributes {pto.aicore} {
    %c128 = arith.constant 128 : i64
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c2 = arith.constant 2 : i64
    %c3 = arith.constant 3 : i64
    %c4 = arith.constant 4 : i64
    %c5 = arith.constant 5 : i64
    pto.ub.vadd %dst, %src0, %src1, %c128, %c0, %c1, %c2, %c3, %c4, %c5 : !pto.ptr<i32, ub>, !pto.ptr<i32, ub>, !pto.ptr<i32, ub>, i64, i64, i64, i64, i64, i64, i64
    return
  }

// CHECK-LABEL: llvm.func @ub_vadd_f32_mix_aiv
// CHECK: llvm.call @llvm.hivm.VADD.f32
  func.func @ub_vadd_f32(%dst: !pto.ptr<f32, ub>, %src0: !pto.ptr<f32, ub>, %src1: !pto.ptr<f32, ub>) attributes {pto.aicore} {
    %c128 = arith.constant 128 : i64
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c2 = arith.constant 2 : i64
    %c3 = arith.constant 3 : i64
    %c4 = arith.constant 4 : i64
    %c5 = arith.constant 5 : i64
    pto.ub.vadd %dst, %src0, %src1, %c128, %c0, %c1, %c2, %c3, %c4, %c5 : !pto.ptr<f32, ub>, !pto.ptr<f32, ub>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64, i64, i64
    return
  }

// Verify packing: each stride field lands at the correct bit position.
// Packing from cce_aicore_intrinsics_3101.h:
//   ((repeat & 0xff) << 56 | (dstBlk & 0xff) << 0  | (src0Blk & 0xff) << 8  |
//    (src1Blk & 0xff) << 16 | (dstRep & 0xff) << 24 | (src0Rep & 0xff) << 32 |
//    (src1Rep & 0xff) << 40)
// CHECK-LABEL: llvm.func @ub_vadd_packed_mix_aiv
// CHECK-DAG: llvm.mlir.constant(56 : i64)
// CHECK-DAG: llvm.mlir.constant(72057594037927936 : i64)
// CHECK-DAG: llvm.mlir.constant(8 : i64)
// CHECK-DAG: llvm.mlir.constant(768 : i64)
// CHECK-DAG: llvm.mlir.constant(16 : i64)
// CHECK-DAG: llvm.mlir.constant(393216 : i64)
// CHECK-DAG: llvm.mlir.constant(24 : i64)
// CHECK-DAG: llvm.mlir.constant(150994944 : i64)
// CHECK-DAG: llvm.mlir.constant(32 : i64)
// CHECK-DAG: llvm.mlir.constant(51539607552 : i64)
// CHECK-DAG: llvm.mlir.constant(40 : i64)
// CHECK-DAG: llvm.mlir.constant(16492674416640 : i64)
// CHECK-NOT: CHECK
// CHECK: llvm.call @llvm.hivm.VADD.s16({{.*}}, {{.*}}, {{.*}}, {{%.*}}) : (!llvm.ptr<6>, !llvm.ptr<6>, !llvm.ptr<6>, i64) -> ()
  func.func @ub_vadd_packed(%dst: !pto.ptr<i16, ub>, %src0: !pto.ptr<i16, ub>, %src1: !pto.ptr<i16, ub>) attributes {pto.aicore} {
    %c1 = arith.constant 1 : i64
    %c2 = arith.constant 2 : i64
    %c3 = arith.constant 3 : i64
    %c6 = arith.constant 6 : i64
    %c9 = arith.constant 9 : i64
    %c12 = arith.constant 12 : i64
    %c15 = arith.constant 15 : i64
    pto.ub.vadd %dst, %src0, %src1, %c1, %c2, %c3, %c6, %c9, %c12, %c15 : !pto.ptr<i16, ub>, !pto.ptr<i16, ub>, !pto.ptr<i16, ub>, i64, i64, i64, i64, i64, i64, i64
    return
  }
}

